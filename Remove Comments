class Solution {
public:
    vector<string> removeComments(vector<string>& source) {
        vector<string> ans;
        string line = "";
        bool inBlock = false;

        for (string s : source) {

            int i = 0;

            while (i < s.length()) {

        
                if (inBlock) {
                    if (i + 1 < s.length() &&
                        s[i] == '*' && s[i + 1] == '/') {
                        inBlock = false;
                        i += 2;
                    }
                    else {
                        i++;
                    }
                }

            
                else {
                    if (i + 1 < s.length() &&
                        s[i] == '/' && s[i + 1] == '/') {
                
                        break;
                    }

                    else if (i + 1 < s.length() &&
                             s[i] == '/' && s[i + 1] == '*') {
            
                        inBlock = true;
                        i += 2;
                    }

                    else {
                        line += s[i];
                        i++;
                    }
                }
            }

    
            if (!inBlock && !line.empty()) {
                ans.push_back(line);
                line = "";
            }
        }

        return ans;
    }
};
