class Solution {
public:
    string simplifyPath(string path) {
        vector<string> st;
        string word = "";

        for (int i = 0; i <= path.length(); i++) {
            if (i == path.length() || path[i] == '/') {

                if (word == "..") {
                    if (!st.empty())
                        st.pop_back();
                }
                else if (word != "" && word != ".") {
                    st.push_back(word);
                }

                word = "";
            }
            else {
                word += path[i];
            }
        }

        string ans = "";

        for (string dir : st) {
            ans += "/" + dir;
        }

        if (ans == "")
            return "/";

        return ans;
    }
};
