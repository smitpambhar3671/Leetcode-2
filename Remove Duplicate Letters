class Solution {
public:
    string removeDuplicateLetters(string s) {
        vector<int> count(26, 0);
        vector<bool> used(26, false);

        for (char ch : s)
            count[ch - 'a']++;

        string st = "";

        for (char ch : s) {
            int x = ch - 'a';
            count[x]--;

            if (used[x])
                continue;

            while (!st.empty() &&
                   st.back() > ch &&
                   count[st.back() - 'a'] > 0) {
                
                used[st.back() - 'a'] = false;
                st.pop_back();
            }

            st.push_back(ch);
            used[x] = true;
        }

        return st;
    }
};
