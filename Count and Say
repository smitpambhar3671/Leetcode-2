class Solution {
public:
    string countAndSay(int n) {
        string s = "1";

        for (int i = 1; i < n; i++) {
            string ans = "";

            for (int j = 0; j < s.length(); ) {
                int count = 1;

                while (j + count < s.length() &&
                       s[j] == s[j + count]) {
                    count++;
                }

                ans += to_string(count);
                ans += s[j];

                j += count;
            }

            s = ans;
        }

        return s;
    }
};
