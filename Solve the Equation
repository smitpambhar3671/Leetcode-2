class Solution {
public:
    pair<int, int> solve(string s) {
        int x = 0;
        int constant = 0;
        int i = 0;
        int sign = 1;

        while (i < s.length()) {

            if (s[i] == '+') {
                sign = 1;
                i++;
            }
            else if (s[i] == '-') {
                sign = -1;
                i++;
            }
            else {
                int num = 0;
                bool hasNumber = false;

                while (i < s.length() && isdigit(s[i])) {
                    num = num * 10 + (s[i] - '0');
                    i++;
                    hasNumber = true;
                }
                if (i < s.length() && s[i] == 'x') {

                    if (!hasNumber)
                        num = 1;

                    x += sign * num;
                    i++;
                }
                else {
                    constant += sign * num;
                }
            }
        }

        return {x, constant};
    }

    string solveEquation(string equation) {

        int equal = equation.find('=');

        string left = equation.substr(0, equal);
        string right = equation.substr(equal + 1);

        pair<int, int> L = solve(left);
        pair<int, int> R = solve(right);

        int xCoefficient = L.first - R.first;
        int constant = R.second - L.second;

        if (xCoefficient == 0) {

            if (constant == 0)
                return "Infinite solutions";

            return "No solution";
        }

        int answer = constant / xCoefficient;

        return "x=" + to_string(answer);
    }
};
