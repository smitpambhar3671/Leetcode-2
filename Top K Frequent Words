class Solution {
public:
    vector<string> topKFrequent(vector<string>& words, int k) {
        map<string, int> mp;

       
        for (string word : words) {
            mp[word]++;
        }

        vector<string> v;

       
        for (auto x : mp) {
            v.push_back(x.first);
        }

        
        sort(v.begin(), v.end(), [&](string a, string b) {
            if (mp[a] != mp[b])
                return mp[a] > mp[b];

            return a < b;
        });

        
        vector<string> ans;

        for (int i = 0; i < k; i++) {
            ans.push_back(v[i]);
        }

        return ans;
    }
};
