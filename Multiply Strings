class Solution {
public:
    string multiply(string num1, string num2) {
        if (num1 == "0" || num2 == "0")
            return "0";

        int n = num1.size();
        int m = num2.size();

        vector<int> ans(n + m, 0);

        for (int i = n - 1; i >= 0; i--) {
            for (int j = m - 1; j >= 0; j--) {
                int product = (num1[i] - '0') * (num2[j] - '0');

                int pos = i + j + 1;

                ans[pos] += product;
                ans[pos - 1] += ans[pos] / 10;
                ans[pos] %= 10;
            }
        }

        string result = "";

        for (int x : ans) {
            if (result.empty() && x == 0)
                continue;

            result += char(x + '0');
        }

        return result;
    }
};
